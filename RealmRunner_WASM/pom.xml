<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.prelle</groupId>
        <artifactId>realmrunner</artifactId>
        <version>0.0.1</version>
    </parent>

  <artifactId>realmrunner-web</artifactId>
  <packaging>jar</packaging>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- MUDClient-Base Core Stack -->
    <dependency>
      <groupId>org.prelle</groupId>
      <artifactId>mudclient-base</artifactId>
      <version>0.0.1</version>
    </dependency>

    <!-- GraalVM Web Image JavaScript Interop API -->
    <dependency>
      <groupId>org.graalvm.webimage</groupId>
      <artifactId>api</artifactId>
      <version>25.2.4</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <configuration>
          <source>25</source>
          <target>25</target>
          <parameters>true</parameters>
          <compilerArgs>
            <arg>--add-reads</arg>
            <arg>org.prelle.realmrunner.wasm=ALL-UNNAMED</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <version>0.10.6</version>
            <extensions>true</extensions>
            <executions>
              <execution>
                <id>build-native</id>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
                <phase>package</phase>
              </execution>
            </executions>
            <configuration>
              <imageName>realmrunner-web</imageName>
              <mainClass>org.prelle.realmrunner.wasm.Client</mainClass>
              <buildArgs>
                <buildArg>--tool:svm-wasm</buildArg>
                <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                <buildArg>--initialize-at-build-time=org.prelle,com.google.gson</buildArg>
              </buildArgs>
            </configuration>
          </plugin>

          <plugin>
            <artifactId>maven-resources-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>copy-wasm-to-web</id>
                <phase>package</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <outputDirectory>${project.parent.basedir}/RealmRunner_Web</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${project.build.directory}</directory>
                      <includes>
                        <include>realmrunner-web.js</include>
                        <include>realmrunner-web.js.wasm</include>
                      </includes>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>