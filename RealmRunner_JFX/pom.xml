<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.prelle</groupId>
  <artifactId>realmrunner-jfx</artifactId>
  <version>0.0.3-SNAPSHOT</version>
  <name>MUDClient-JFX</name>
  <description>MUD client written in Java+JavaFX</description>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<javafx.version>26.0.2</javafx.version>
		<maven.deploy.skip>false</maven.deploy.skip>
		<maven.install.skip>false</maven.install.skip>
		<javafx.plugin.version>0.0.8</javafx.plugin.version>
		<client.plugin.version>1.0.21</client.plugin.version>
		<maven.compiler.target>25</maven.compiler.target>
		<maven.compiler.source>25</maven.compiler.source>
	</properties>

	<repositories>
    	<repository>
        	<id>jitpack.io</id>
        	<url>https://jitpack.io</url>
    	</repository>
    	<repository>
    		<id>terminalfx-repo</id>
    		<url>https://github.com/javaterminal/terminalfx/raw/master/releases</url>
    	</repository>
	</repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.graphicmud</groupId>
                <artifactId>graphicmud-parent</artifactId>
                <version>0.5.0-SNAPSHOT</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

	<dependencies>
	  <dependency>
		  <groupId>org.prelle</groupId>
		  <artifactId>telnet</artifactId>
		  <version>1.0.0-SNAPSHOT</version>
	  </dependency>
      <dependency>
          <groupId>org.prelle</groupId>
          <artifactId>mudclient-base</artifactId>
          <version>0.0.1</version>
      </dependency>
      <dependency>
          <groupId>com.graphicmud</groupId>
          <artifactId>graphicmud-core</artifactId>
          <exclusions>
          	<exclusion>
          		<groupId>com.fasterxml.jackson.dataformat</groupId>
          		<artifactId>jackson-dataformat-yaml</artifactId>
          	</exclusion>
          </exclusions>
      </dependency>
	  <dependency>
		  	<groupId>com.graphicmud</groupId>
  			<artifactId>tile-service-jfx</artifactId>
	  </dependency>
      <dependency>
         <groupId>org.prelle</groupId>
          <artifactId>libterminal-ghosttyfx</artifactId>
          <version>0.0.1</version>
      </dependency>
      <!-- Alternative to libterminal-ghosttyfx -->
      <dependency>
         <groupId>org.prelle</groupId>
          <artifactId>libterminal-jeditermfx</artifactId>
          <version>0.0.1</version>
      </dependency>
	  <dependency>
		  <groupId>org.prelle</groupId>
		  <artifactId>libterminal-jfx</artifactId>
		  <version>0.0.1</version>
	  </dependency>
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-base</artifactId>
			<version>${javafx.version}</version>
		</dependency>
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-graphics</artifactId>
			<version>${javafx.version}</version>
		</dependency>
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-controls</artifactId>
			<version>${javafx.version}</version>
		</dependency>
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-swing</artifactId>
			<version>${javafx.version}</version>
		</dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-media</artifactId>
            <version>${javafx.version}</version>
        </dependency>
       <dependency>
            <groupId>org.prelle</groupId>
            <artifactId>javafx-extensions</artifactId>
            <version>6.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.4</version>
        </dependency>
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
            <version>2.0.0</version>
        </dependency>

	</dependencies>
</project>